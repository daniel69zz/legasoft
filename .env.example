# Variables del backend local (docker compose). Copiar a .env y ajustar:
#   cp .env.example .env
# Si no existe .env, docker-compose.yml usa estos mismos valores por defecto.
# Son solo para desarrollo: .env no se versiona.

# PostgreSQL central (superusuario postgres). Las claves de los usuarios por
# servicio (identity_svc, business_svc, sync_svc) están en deploy/postgres/01-schemas.sql.
POSTGRES_PASSWORD=postgres_dev
POSTGRES_PORT=5433

# Clave para firmar el JWT (mínimo 32 caracteres). Debe ser la misma en todos los servicios.
JWT_KEY=solo-para-desarrollo-cambiar-en-produccion-0123456789

# Clave entre servicios para los endpoints /internal (Sync → Business, Notification → Business).
INTERNAL_KEY=clave-interna-solo-desarrollo

# Puertos publicados en la computadora.
# Si cambia GATEWAY_PORT, ejecute el Desktop con --Desktop:GatewayUrl=http://localhost:<puerto>
GATEWAY_PORT=5100
MAILPIT_PORT=8025

# Cada cuántos minutos el Notification Worker revisa vencimientos y stock mínimo.
ALERT_INTERVAL_MINUTES=5
