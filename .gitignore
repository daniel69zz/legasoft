# --- Archivos auxiliares de LaTeX -------------------------------------------
*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.run.xml

# Los PDF son artefactos de compilación: se generan con `make`.
# Si el curso exige entregar los PDF versionados, comente estas dos líneas.
docs/**/*.pdf
modelos/**/*.pdf

# Excepción deliberada: el PDF de entrega sí se versiona, porque es la evidencia
# de qué se presentó y en qué fecha.
!docs/entrega/*.pdf

# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db

# Excepción: los documentos entregables del proyecto (DOCn-*.pdf) se versionan,
# porque su fuente es Word y no se generan con `make`.
!docs/**/DOC[0-9]-*.pdf
