# HU-T02.2 (RNF-003): Caddy termina TLS delante del API Gateway. Solo acepta TLS 1.2 y 1.3, y
# redirige automáticamente HTTP (puerto 80) a HTTPS. El Gateway sigue escuchando solo dentro de
# la red de Docker. Variables en .env: PUBLIC_DOMAIN y, para Let's Encrypt, TLS_EMAIL.
{$PUBLIC_DOMAIN} {
	tls {$TLS_EMAIL} {
		protocols tls1.2 tls1.3
	}
	header Strict-Transport-Security "max-age=31536000"
	encode gzip
	reverse_proxy gateway:8080
}
