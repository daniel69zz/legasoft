    {
      "name": "HU-05 · Catálogo de medicamentos (SCRUM-15)",
      "item": [
        {
          "name": "Buscar medicamentos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog?search=para",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "para"
                }
              ]
            },
            "description": "RF-012. Busca por nombre, código, principio activo o categoría. Permiso Catálogo: Administrador, Farmacéutico, Gerente de Operaciones."
          }
        },
        {
          "name": "Registrar medicamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog"
              ]
            },
            "description": "RF-009. Código duplicado → 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"MED-001\",\n  \"name\": \"Ibuprofeno\",\n  \"activeIngredient\": \"Ibuprofeno\",\n  \"concentration\": \"400 mg\",\n  \"presentation\": \"Tableta\",\n  \"laboratory\": \"Inti\",\n  \"category\": \"Analgésicos\",\n  \"requiresPrescription\": false,\n  \"salePrice\": 0.8,\n  \"minimumStock\": 20,\n  \"location\": \"Estante B1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificar medicamento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "{{productId}}"
              ]
            },
            "description": "RF-010. El código no cambia.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"MED-001\",\n  \"name\": \"Ibuprofeno Forte\",\n  \"activeIngredient\": \"Ibuprofeno\",\n  \"concentration\": \"600 mg\",\n  \"presentation\": \"Tableta\",\n  \"laboratory\": \"Inti\",\n  \"category\": \"Analgésicos\",\n  \"requiresPrescription\": false,\n  \"salePrice\": 1.1,\n  \"minimumStock\": 20,\n  \"location\": \"Estante B1\"\n}"
            }
