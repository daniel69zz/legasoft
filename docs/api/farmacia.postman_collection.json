            "description": "RF-030, RF-031. Guarda `purchaseId` y `lineId`; el total se calcula solo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 100,\n      \"unitCost\": 0.3\n    }\n  ]\n}"
