              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"PUESTO-01\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
