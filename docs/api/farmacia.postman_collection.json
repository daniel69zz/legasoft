            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/{{productId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "{{productId}}",
                "deactivate"
