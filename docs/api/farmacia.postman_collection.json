{
  "info": {
    "name": "Sistema de Gestión para Farmacéutica (Legasoft)",
    "description": "Endpoints del API Gateway (Sprint 1). Levante el backend con `docker compose -p farmacia up -d --build` y ejecute primero **Login como admin**. La especificación OpenAPI completa está en http://localhost:5100/swagger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5100"
    },
    {
      "key": "password",
      "value": "Farmacia2026!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "productId",
      "value": "00000000-0000-0000-0001-000000000001"
    }
  ],
  "item": [
    {
      "name": "HU-01 · Inicio de sesión (SCRUM-2)",
      "item": [
        {
          "name": "Login como admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "RF-001. Guarda el token en la variable de colección `token`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"PUESTO-01\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login como farmaceutico",
