    {
      "name": "HU-02 · Usuarios, roles y permisos (SCRUM-10)",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "RF-002. Solo Administrador; con otro rol responde 403."
          }
        },
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "RF-003. Usuario duplicado → 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"cajero3\",\n  \"fullName\": \"Cajero de prueba\",\n  \"password\": \"ClaveSegura1\",\n  \"role\": \"Cajero\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificar usuario (nombre y rol)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "description": "RF-004. El rol nuevo se aplica en el siguiente inicio de sesión.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Cajero de prueba\",\n  \"role\": \"Farmaceutico\"\n}"
            }
          }
        },
        {
          "name": "Desactivar usuario",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "deactivate"
              ]
            },
            "description": "RF-005. El usuario ya no puede iniciar sesión."
          }
        },
        {
          "name": "Reactivar usuario",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/activate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "activate"
              ]
            },
            "description": "RF-005."
          }
        },
        {
          "name": "Auditoría de usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/audit",
