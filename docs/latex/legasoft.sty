\RequirePackage{bookmark}
\urlstyle{sf}

% Ruta de archivo o carpeta. Se compone en monoespaciado y admite cortes de línea
% tras «/», sin introducir guiones — a diferencia de \texttt, que desborda el
% margen cuando la ruta es larga.
\newcommand{\ruta}[1]{\begingroup\urlstyle{tt}\nolinkurl{#1}\endgroup}

% Da algo de elasticidad al espaciado interno de rutas y URL, para que el
% ajuste de línea no las empuje fuera del margen.
\setlength{\Urlmuskip}{0mu plus 1.2mu}

\endinput
