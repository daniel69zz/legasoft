\newcommand{\lgcodigo}[1]{\def\lg@codigo{#1}}
\newcommand{\lgversion}[1]{\def\lg@version{#1}}
\newcommand{\lgfecha}[1]{\def\lg@fecha{#1}}
\newcommand{\lgautor}[1]{\def\lg@autor{#1}}
\newcommand{\lgestado}[1]{\def\lg@estado{#1}}
