% ----------------------------------------------------------- encabezado y pie
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{lgBorde}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{lgBorde}\leaders\hrule height \footrulewidth\hfill}}
\fancyhead[L]{\sffamily\footnotesize\color{lgPrimario}\textbf{Legasoft}}
\fancyhead[R]{\sffamily\footnotesize\color{lgGris}\lg@tituloCorto}
\fancyfoot[L]{\sffamily\scriptsize\color{lgGris}\lg@codigo\ · v\lg@version}
\fancyfoot[R]{\sffamily\scriptsize\color{lgGris}Página \thepage\ de \pageref{LastPage}}

\fancypagestyle{lgportada}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% ---------------------------------------------------------------- títulos
\titleformat{\section}
  {\sffamily\Large\bfseries\color{lgPrimario}}
  {\thesection}{0.7em}{}
  [{\vspace{2pt}\color{lgBorde}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{1.9\baselineskip}{0.7\baselineskip}

\titleformat{\subsection}
  {\sffamily\large\bfseries\color{lgPrimario!85!black}}
  {\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.3\baselineskip}{0.45\baselineskip}

\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{lgGris}}
  {\thesubsubsection}{0.55em}{}
\titlespacing*{\subsubsection}{0pt}{1.05\baselineskip}{0.35\baselineskip}

\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}

% ---------------------------------------------------------------- listas
\setlist[itemize]{leftmargin=1.35em,itemsep=2pt,topsep=4pt,parsep=0pt}
\setlist[enumerate]{leftmargin=1.6em,itemsep=2pt,topsep=4pt,parsep=0pt}
\setlist[description]{leftmargin=1.35em,itemsep=3pt,topsep=4pt,font=\sffamily\bfseries\color{lgPrimario}}

% ---------------------------------------------------------------- tablas
\renewcommand{\arraystretch}{1.25}
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\Centering\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}

% Encabezado de tabla con fondo institucional.
\newcommand{\lgth}[1]{\textcolor{white}{\sffamily\bfseries #1}}
\newcommand{\lgfilacab}{\rowcolor{lgPrimario}}

\captionsetup{font={small},labelfont={sf,bf,color=lgPrimario},
              textfont={color=lgGris},skip=6pt}

% ---------------------------------------------------------------- cajas
\newtcolorbox{nota}[1][Nota]{%
  enhanced, breakable, colback=lgClaro, colframe=lgAcento,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries\small, coltitle=lgPrimario,
  attach boxed title to top left={xshift=8pt, yshift=-2pt},
  boxed title style={colback=lgClaro, boxrule=0pt, arc=0pt},
  title={#1}}

\newtcolorbox{porcompletar}[1][Por completar]{%
  enhanced, breakable, colback=lgAmbarClaro, colframe=lgAmbar,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries\small, coltitle=lgAmbar,
  attach boxed title to top left={xshift=8pt, yshift=-2pt},
  boxed title style={colback=lgAmbarClaro, boxrule=0pt, arc=0pt},
  title={#1}}

% Marca en línea para un dato que el equipo aún debe rellenar.
\newcommand{\campo}[1]{\textcolor{lgAmbar}{\sffamily\small[#1]}}

% Igual que \campo, pero para usar sobre fondos oscuros (cajas azules de los
% diagramas), donde el ámbar normal no tiene contraste suficiente.
\definecolor{lgAmbarSuave}{HTML}{F4C77E}
\newcommand{\campoclaro}[1]{\textcolor{lgAmbarSuave}{\sffamily\small[#1]}}

% Reduce una figura solo si excede el ancho del texto; si cabe, no la toca.
% Uso: \ajustaancho{\begin{tikzpicture}...\end{tikzpicture}}
\newcommand{\ajustaancho}[1]{%
  \resizebox{\ifdim\width>\linewidth\linewidth\else\width\fi}{!}{#1}}

