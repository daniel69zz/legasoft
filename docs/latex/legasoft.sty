%% legasoft.sty — Estilo común de los documentos de Legasoft
%% Motor: XeLaTeX (compilar con Tectonic). Ver docs/latex/README.md
\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{legasoft.sty}[2026/08/12 Estilo institucional de Legasoft]

% ---------------------------------------------------------------- tipografía
\RequirePackage{fontspec}
\setmainfont{texgyrepagella-regular.otf}[
  BoldFont       = texgyrepagella-bold.otf,
  ItalicFont     = texgyrepagella-italic.otf,
  BoldItalicFont = texgyrepagella-bolditalic.otf]
\setsansfont{texgyreheros-regular.otf}[
  BoldFont       = texgyreheros-bold.otf,
  ItalicFont     = texgyreheros-italic.otf,
  BoldItalicFont = texgyreheros-bolditalic.otf]
\setmonofont{texgyrecursor-regular.otf}[
  Scale          = 0.92,
  BoldFont       = texgyrecursor-bold.otf,
  ItalicFont     = texgyrecursor-italic.otf,
  BoldItalicFont = texgyrecursor-bolditalic.otf]

% `es-noshorthands` es obligatorio: sin él, babel-spanish activa `<`, `>` y `"`,
% y rompe las flechas de TikZ (\draw[<->]) y las opciones de tabularx.
\RequirePackage[spanish,es-noshorthands,es-tabla,es-nodecimaldot]{babel}

\RequirePackage{microtype}
\RequirePackage{parskip}
\RequirePackage{setspace}
\RequirePackage{ragged2e}

% ------------------------------------------------------------------ paquetes
\RequirePackage[a4paper,top=2.7cm,bottom=2.6cm,left=2.6cm,right=2.6cm,
                headheight=22pt,footskip=1.2cm]{geometry}
\RequirePackage[table]{xcolor}   % `table` habilita \rowcolor / \cellcolor
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{etoolbox}
\RequirePackage{lastpage}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{tikz}
\usetikzlibrary{positioning,shapes.geometric,shapes.symbols,shapes.multipart,
                arrows.meta,calc,fit,backgrounds,decorations.pathreplacing,
                patterns,matrix,chains}
\RequirePackage[most]{tcolorbox}

