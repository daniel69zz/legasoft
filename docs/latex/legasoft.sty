% ---------------------------------------------------------------- hyperref
\RequirePackage[hidelinks,unicode]{hyperref}
\hypersetup{
  pdfauthor   = {Legasoft},
  pdfcreator  = {XeLaTeX / Tectonic},
  colorlinks  = true,
  linkcolor   = lgPrimario,
