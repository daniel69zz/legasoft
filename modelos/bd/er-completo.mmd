---
title: Base central PostgreSQL · Sistema de Gestión para Farmacéutica
---
erDiagram
    USERS {
        uuid id PK
        varchar user_name UK "único, máx. 60"
        text full_name
        text password_hash "PBKDF2 (PasswordHasher)"
        text role "uno de los 7 roles del SRS"
        boolean is_active
        int failed_attempts
        timestamptz first_failed_at "nullable"
        timestamptz locked_until "nullable"
        timestamptz created_at
    }
    DEVICES {
        text device_id PK
        text description
        boolean is_active
    }
    ATTENDANCE {
        uuid id PK
        text user_name
        text device_id
        date day
        timestamptz first_login_at
    }
    USER_CHANGES {
        uuid id PK
        timestamptz occurred_at
        text changed_by
        text action
        text detail
    }
    PRODUCTS {
        uuid id PK
        text code UK "código de producto"
        text name "nombre comercial"
        text active_ingredient
        text concentration
        text presentation
        text laboratory
        text category
        boolean requires_prescription
        numeric sale_price "12,2"
        int minimum_stock
        text location
        boolean is_active
        timestamptz updated_at "versión para la descarga incremental"
    }
    LOTS {
        uuid id PK
        uuid product_id
        text lot_number
        date expiration_date
        int quantity
    }
    STOCK_MOVEMENTS {
        uuid id PK
        uuid product_id
        uuid lot_id
        text type "Venta, Compra, Ajuste, Retiro"
        int quantity
        text reason
        text user_name
        timestamptz occurred_at
    }
    SALES {
        uuid id PK
        text receipt_number
        text device_id
        text cashier_name
        uuid cash_session_id
        timestamptz created_at
        numeric subtotal
        numeric discount
        numeric total
        numeric cash_received
        numeric change
        text prescription_number
        text customer_name
        text customer_tax_id
        text status "Completada, Anulada"
        text void_reason
    }
    SALE_LINES {
        uuid id PK
        uuid sale_id FK
        uuid product_id
        text product_name
        uuid lot_id
        text lot_number
        int quantity
        numeric unit_price
    }
    CASH_SESSIONS {
        uuid id PK
        text device_id
        text cashier_name
        timestamptz opened_at
        numeric opening_amount
        text status "Abierta, Cerrada"
        numeric sales_total "nullable"
        numeric expenses_total "nullable"
        numeric expected_amount "nullable"
        numeric counted_amount "nullable"
        numeric difference "nullable"
        text justification
        timestamptz closed_at "nullable"
    }
    CASH_MOVEMENTS {
        uuid id PK
        uuid cash_session_id
        text type "Venta, Egreso, AnulacionVenta"
        numeric amount
        text reason
        text category
        text user_name
        timestamptz occurred_at
    }
    AUDIT_ENTRIES {
        uuid id PK
        timestamptz occurred_at
        text user_name
        text device_id
        text action
        text detail
        uuid event_id "nullable"
    }
    RECEIVED_EVENTS {
        uuid event_id PK "clave de idempotencia"
        text device_id
        text module
        text event_type
        uuid entity_id
        int version
        timestamptz timestamp
        timestamptz received_at
        text payload "JSON"
    }
    MODULE_VERSIONS {
        text device_id PK
        text module PK
        bigint version
        timestamptz updated_at
    }
    USERS ||..o{ ATTENDANCE : "registra asistencia"
    DEVICES ||..o{ ATTENDANCE : "en el equipo"
    USERS ||..o{ USER_CHANGES : "cambios auditados"
    PRODUCTS ||..o{ LOTS : "tiene"
    LOTS ||..o{ STOCK_MOVEMENTS : "registra"
    SALES ||--|{ SALE_LINES : "contiene"
    PRODUCTS ||..o{ SALE_LINES : "vendido en"
    LOTS ||..o{ SALE_LINES : "sale del lote (FEFO)"
    CASH_SESSIONS ||..o{ CASH_MOVEMENTS : "registra"
    CASH_SESSIONS ||..o{ SALES : "cobra"
    RECEIVED_EVENTS }o..|| MODULE_VERSIONS : "avanza la versión"
    RECEIVED_EVENTS |o..o| AUDIT_ENTRIES : "origen del registro"
