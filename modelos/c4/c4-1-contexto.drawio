<mxfile host="app.diagrams.net" type="device"><diagram id="c4-1-contexto.drawio" name="C1 - Contexto"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Figura 1. Diagrama de contexto (C1)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#555&#x27;&gt;Sistema de Gestión para Farmacéutica&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Configura parámetros, usuarios, roles, dispositivos, proveedores, compras e inventario&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Gerente General&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Consulta dashboard, indicadores, ventas por cajero y precios de proveedores&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="190" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Contadora&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Revisa cierres diarios y de caja; exporta reportes Excel/PDF&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="190" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Gerente de Operaciones&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Supervisa recepciones, ajustes de inventario, ubicación y vencimientos&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="210" height="190" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cajero&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Registra ventas, cobros en efectivo, recibos, egresos, arqueo y cierre (equipo autorizado)&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="210" height="190" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Farmacéutico / Almacén&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Gestiona medicamentos, recetas, lotes, recepción y existencias&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1290" y="110" width="210" height="190" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Frontera del sistema&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Construido, desplegado y operado por el equipo]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="820" height="300" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Sistema de Gestión para Farmacéutica&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Aplicación de escritorio local-first (SQLite por puesto) + servicios cloud ASP.NET Core con PostgreSQL central. Ventas, caja, inventario, compras, recetas, reportes, sincronización y facturación simulada (sin SIN).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="490" y="450" width="600" height="200" as="geometry"/></mxCell><mxCell id="c12" value="Usa&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Aplicación de escritorio]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Usa&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Aplicación de escritorio]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.26;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Usa&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Aplicación de escritorio]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.42;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Usa&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Aplicación de escritorio]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.58;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="Usa&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Aplicación de escritorio]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.74;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Usa&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Aplicación de escritorio]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cliente de la farmacia&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona externa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Paga en efectivo en el mostrador y recibe recibo o factura simulada&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="200" height="190" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Envía alertas de vencimiento, stock mínimo y reportes programados&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="860" width="300" height="150" as="geometry"/></mxCell><mxCell id="c20" value="Realiza compra y pago en efectivo&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Atención en mostrador]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#A0A0A0;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="610"/></Array></mxGeometry></mxCell><mxCell id="c21" value="Envía alertas y reportes&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[SMTP con TLS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Todas las personas usan una única aplicación de escritorio, diferenciadas por roles y permisos.&lt;br&gt;• La facturación es simulada (numeración interna, sin validez fiscal) y se resuelve dentro de la frontera.&lt;br&gt;• Todos los pagos se realizan en efectivo y se registran en la caja del puesto; no hay pagos electrónicos ni conexión con entidades bancarias.&lt;br&gt;• El único sistema externo es el servicio de correo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="440" width="340" height="210" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="780" width="200" height="26" as="geometry"/></mxCell><mxCell id="c24" value="Persona" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="810" width="200" height="32" as="geometry"/></mxCell><mxCell id="c25" value="Persona externa" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="848" width="200" height="32" as="geometry"/></mxCell><mxCell id="c26" value="Sistema en alcance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="886" width="200" height="32" as="geometry"/></mxCell><mxCell id="c27" value="Sistema externo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1420" y="924" width="200" height="32" as="geometry"/></mxCell><mxCell id="c28" value="Frontera del sistema" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1420" y="962" width="200" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>