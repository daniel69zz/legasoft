pper]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="519"/><mxPoint x="110" y="1085"/></Array></mxGeometry></mxCell><mxCell id="c27" value="Lee Outbox / aplica cambios&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[EF Core]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Envía lotes / descarga cambios&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[HTTPS/REST (JSON) + JWT]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Login y consultas en línea&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[HTTPS/REST (JSON) + JWT]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=1;