<mxfile host="app.diagrams.net" type="device"><diagram id="c4-2-contenedores.drawio" name="C2 - Contenedores"><mxGraphModel dx="2100" dy="1420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Figura 2. Diagrama de contenedores (C2)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#555&#x27;&gt;Sistema de Gestión para Farmacéutica&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cajero&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Ventas, cobros en efectivo y caja desde equipo autorizado&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="90" y="100" width="190" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Personal administrativo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Administrador, Gerentes, Contadora, Farmacéutico / Almacén&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="190" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cliente de la farmacia&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona externa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Paga en efectivo al cajero y recibe comprobante&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="190" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Sistema de Gestión para Farmacéutica&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Sistema de software]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="1720" height="1060" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Puesto de la farmacia (local, por computadora autorizada)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Entorno local]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="520" height="1000" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Entorno cloud (VPS / proveedor cloud, Docker)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Entorno cloud]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="610" y="350" width="1100" height="1000" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Aplicación Desktop&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[C# .NET 8, Avalonia UI, MVVM, Pharmacy.Domain / Application]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Interfaz de todos los roles. Ejecuta localmente ventas con pago en efectivo, caja e inventario; consulta servicios cloud con conexión.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="150" y="400" width="280" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Sync Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[C# BackgroundService (en el proceso Desktop)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Envía por lotes el Outbox al Sync Service y aplica en SQLite los cambios descargados.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="150" y="700" width="280" height="140" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SQLite local&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[SQLite + EF Core / Dapper]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Única base del puesto: productos, precios, lotes, stock, ventas, caja, Outbox y estado de sync.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="150" y="1000" width="280" height="170" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core + YARP, Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Punto de entrada único para la Aplicación Desktop: enrutamiento, TLS, límites de solicitudes, correlación.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="240" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Servidor de actualizaciones&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Velopack, almacenamiento estático HTTPS]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Publica instaladores y paquetes delta firmados.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="400" width="240" height="140" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Identity Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core Identity + JWT, Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Usuarios, roles, permisos, dispositivos autorizados; emisión y renovación de tokens.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="380" width="250" height="140" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Sync Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core Web API, Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Fachada de sincronización: idempotencia, versiones, despacho de eventos y cambios incrementales.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="250" height="150" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Business Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core Web API + lógica compartida, Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Ventas, inventario, caja y efectivo, compras, proveedores, clientes, recetas y reportes.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="750" width="250" height="150" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Módulo de caja y efectivo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Parte del Business Service]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Apertura, egresos, conteo por denominación, arqueo, cierre y justificación de diferencias.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="950" width="250" height="140" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core + BackgroundService, Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Alertas de vencimiento y stock mínimo; reportes programados por correo.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="1150" width="250" height="140" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;PostgreSQL central&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[PostgreSQL administrado]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Fuente consolidada. Schemas: sales, inventory, cash, identity, audit, sync.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1400" y="700" width="260" height="200" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Entrega de alertas y reportes programados.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1820" y="1160" width="240" height="120" as="geometry"/></mxCell><mxCell id="c22" value="Paga en efectivo y recibe comprobante&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[Mostrador]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColo