xitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1220"/><mxPoint x="640" y="1220"/></Array></mxGeometry></mxCell><mxCell id="c44" value="Lee / actualiza versiones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="Envía lotes Outbox / descarga cambios&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[HTTPS/REST + JWT]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;startArrow=blockThin;startFill=1;startSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="Aplica cambios descargados" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#A0A0A0;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1040"/><mxPoint x="200" y="1040"/></Array></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="Lee / escribe (transacción única)&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[SQLite / EF Core]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="&lt;b&gt;Flujo de venta con pago en efectivo&lt;/b&gt;&lt;br&gt;1. El cajero confirma productos y cantidades en el POS.&lt;br&gt;2. CobroEfectivoHandler registra el monto recibido y calcula el cambio.&lt;br&gt;3. SalesLocalService registra la venta, recibo/factura simulada y movimiento de caja en SQLite.&lt;br&gt;4. CashLocalService actualiza el efectivo esperado del turno.&lt;br&gt;5. SyncWorker envía la venta y los movimientos de caja cuando hay conexión." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1480" width="420" height="170" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Flujo de venta sin conexión&lt;/b&gt;&lt;br&gt;1. El cajero confirma la venta en la vista POS → ViewModel → SalesLocalService.&lt;br&gt;2. Se valida y aplica Pharmacy.Domain (totales, FEFO, bloqueo de vencidos).&lt;br&gt;3. En UNA transacción SQLite: venta, detalle, movimiento de stock, movimiento de caja y Outbox.&lt;br&gt;4. Se emite recibo / factura simulada.&lt;br&gt;5. Con conectividad, el SyncWorker envía y marca como sincronizado." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="870" y="1480" width="440" height="170" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="1260" width="200" height="26" as="geometry"/></mxCell><mxCell id="c54" value="Persona" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1330" y="1290" width="200" height="32" as="geometry"/></mxCell><mxCell id="c55" value="Componente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1330" y="1328" width="200" height="32" as="geometry"/></mxCell><mxCell id="c56" value="Lógica compartida" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#B3E5C7;strokeColor=#5FA67A;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1330" y="1366" width="200" height="32" as="geometry"/></mxCell><mxCell id="c57" value="Contenedor externo al alcance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1330" y="1404" width="200" height="32" as="geometry"/></mxCell><mxCell id="c58" value="Frontera del contenedor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="1442" width="200" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>