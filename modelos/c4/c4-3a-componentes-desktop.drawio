<mxfile host="app.diagrams.net" type="device"><diagram id="c4-3a-componentes-desktop.drawio" name="C3 - Aplicación Desktop"><mxGraphModel dx="1650" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Figura 3. Diagrama de componentes (C3) — Aplicación Desktop&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#555&#x27;&gt;Contenedor: Aplicación Desktop (C# .NET 8, Avalonia UI)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Usuarios de la farmacia&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Cajero, Administrador, Gerentes, Contadora, Farmacéutico&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="220" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Aplicación Desktop&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor: C# .NET 8, Avalonia UI, MVVM]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1180" height="1100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Avalonia Views&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: XAML]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Pantallas de venta (POS), caja, inventario, compras, reportes y administración.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="490" y="350" width="280" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;ViewModels&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: MVVM]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Estado de pantalla y comandos; delegan en servicios locales, sin acceso directo a BD.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="490" y="520" width="280" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;ConnectivityMonitor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: C#]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Health check periódico al API Gateway; informa disponibilidad de login, consultas en línea y sincronización.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="280" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SalesLocalService&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: C#]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Totales, FEFO, bloqueo de vencidos, verificación de receta, pago en efectivo, recibo/factura simulada y Outbox.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="260" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;InventoryLocalService&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: C#]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Productos, precios, lotes y stock local; movimientos de inventario.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340" y="700" width="260" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;CashLocalService&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: C#]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Apertura, movimientos, conteo por denominación, arqueo y cierre de caja con usuario responsable.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="260" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;CobroEfectivoHandler&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: C#]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Registra el monto recibido en efectivo, calcula el cambio y deriva el movimiento a caja.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="260" height="130" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Pharmacy.Application&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Biblioteca compartida .NET]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Casos de uso, comandos, FluentValidation e interfaces de repositorios.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#B3E5C7;strokeColor=#5FA67A;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="890" width="300" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Pharmacy.Domain&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Biblioteca compartida .NET]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Entidades y reglas: ventas, FEFO, lotes vencidos, stock y caja.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#B3E5C7;strokeColor=#5FA67A;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="890" width="300" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;LocalRepositories&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: EF Core / Dapper]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Implementan interfaces de Pharmacy.Application para ventas, inventario y caja.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="1070" width="240" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;OutboxRepository&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: EF Core]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Inserta Outbox en la misma transacción; marca confirmados.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="1070" width="240" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SyncStateRepository&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: EF Core]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Última versión por módulo (sales/inventory/cash_version) e id de dispositivo.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="1070" width="240" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SyncWorker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: BackgroundService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Envía Outbox por lotes con reintentos y aplica cambios descargados.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="940" y="1070" width="240" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SQLite DbContext&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente: EF Core DbContext]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Transacciones y migraciones del esquema local.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="1260" width="520" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SQLite local&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor: SQLite]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Base única del puesto con tablas por módulo y Outbox.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="490" y="1480" width="260" height="150" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;API Gateway → servicios cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor: ASP.NET Core + YARP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Sync, Identity, Business, reportes y notificaciones.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1330" y="1070" width="260" height="130" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Servidor de actualizaciones&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor: Velopack]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Paquetes firmados de nuevas versiones.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1330" y="350" width="260" height="110" as="