l=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="1280" /><mxPoint x="760" y="1280" /></Array></mxGeometry></mxCell><mxCell id="c80" value="sales · inventory · cash · audit&lt;br&gt;&lt;span style='font-size:9px'&gt;[EF Core TLS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c82" value="solo lectura (vistas)&lt;br&gt;&lt;span style='font-size:9px'&gt;[Npgsql TLS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2060" y="1380" /></Array></mxGeometry></mxCell><mxCell id="c83" value="&lt;b&gt;Reglas de pago en efectivo&lt;/b&gt;&lt;br&gt;• La venta se confirma directamente en caja, sin servicios financieros externos.&lt;br&gt;• Cada venta registra monto cobrado en efectivo, cambio entregado, usuario y caja del puesto.&lt;br&gt;• La caja consolida apertura, ingresos por venta, egresos, conteo por denominación, arqueo y cierre.&lt;br&gt;• Las diferencias de caja requieren justificación antes del cierre del turno." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1330" y="1500" width="620" height="150" as="geometry" /></mxCell><mxCell id="c84" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1500" width="200" height="26" as="geometry" /></mxCell><mxCell id="c85" value="Persona externa" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="1530" width="200" height="32" as="geometry" /></mxCell><mxCell id="c86" value="Componente" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="1568" width="200" height="32" as="geometry" /></mxCell><mxCell id="c87" value="Contenedor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="1606" width="200" height="32" as="geometry" /></mxCell><mxCell id="c88" value="Sistema externo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="1644" width="200" height="32" as="geometry" /></mxCell><mxCell id="c89" value="Frontera del servicio" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1682" width="200" height="32" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>