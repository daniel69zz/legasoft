<mxfile host="app.diagrams.net" type="device"><diagram id="c4-3b-componentes-backend.drawio" name="C3 - Backend Cloud"><mxGraphModel dx="2040" dy="1680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Figura 4. Diagrama de componentes (C3) — Backend Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#555&#x27;&gt;Servicios ASP.NET Core en Docker sobre PostgreSQL administrado&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Aplicación Desktop + Sync Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor: C# .NET 8, Avalonia]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Puestos de la farmacia con ventas, caja local y sincronización.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="280" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Backend Cloud&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedores ASP.NET Core en Docker]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="1610" height="1210" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core + YARP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Enrutamiento, TLS, límites de solicitudes y correlación.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="320" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Pipeline común en cada servicio&lt;/b&gt;&lt;br&gt;① Middleware de excepciones + logging Serilog (ProblemDetails, correlation-id)&lt;br&gt;② Middleware JWT: valida token del Identity Service, roles y dispositivo autorizado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1200" y="300" width="420" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Sync Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor · schema sync]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="350" height="780" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SyncController&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core Controller]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Recepción de lotes y entrega de cambios incrementales&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="500" width="300" height="105" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;IdempotencyStore&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Descarta eventos ya procesados (eventId)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="635" width="300" height="105" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;VersionManager&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Versiones por módulo y dispositivo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="770" width="300" height="105" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;ConflictResolver&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Reglas de conflicto por entidad&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="905" width="300" height="105" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;EventDispatcher&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Despacha eventos por module / eventType&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSi