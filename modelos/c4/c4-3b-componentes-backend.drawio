<mxfile host="app.diagrams.net" type="device"><diagram id="C3_Componentes_Backend_Cloud.drawio" name="C3 - Backend Cloud"><mxGraphModel dx="2720" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2720" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c3" value="&lt;b style='font-size:20px'&gt;Figura 4. Diagrama de componentes (C3) — Backend Cloud&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Servicios ASP.NET Core en Docker sobre PostgreSQL administrado&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="60" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b style='font-size:13px'&gt;Aplicación Desktop + Sync Worker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor: C# .NET 8, Avalonia]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Puestos de la farmacia con ventas, caja local y sincronización.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="280" height="110" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;Cliente de la farmacia&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Persona externa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Paga en efectivo en mostrador; no interactúa con el backend.&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;verticalAlign=bottom;spacingBottom=8;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2460" y="950" width="190" height="170" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;Backend Cloud&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedores ASP.NET Core en Docker]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1168BD;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="2340" height="1210" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ASP.NET Core + YARP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Enrutamiento, TLS, límites de solicitudes y correlación.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="320" height="110" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;Pipeline común en cada servicio&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;① Middleware de excepciones + logging Serilog (ProblemDetails, correlation-id)&lt;br&gt;② Middleware JWT: valida token del Identity Service, roles y dispositivo autorizado&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFF8DC;strokeColor=#C9B458;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1230" y="292" width="500" height="100" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;Sync Service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor · schema sync]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="350" height="780" as="geometry" /></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;SyncController&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ASP.NET Core Controller]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Recepción de lotes y entrega de cambios incrementales&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="500" width="300" height="105" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;IdempotencyStore&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Descarta eventos ya procesados (eventId)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="635" width="300" height="105" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;VersionManager&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Versiones por módulo y dispositivo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="770" width="300" height="105" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b style='font-size:13px'&gt;ConflictResolver&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Reglas de conflicto por entidad&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="905" width="300" height="105" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b style='font-size:13px'&gt;EventDispatcher&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Despacha eventos por module / eventType&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="85" y="1040" width="300" height="105" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b style='font-size:13px'&gt;Identity Service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor · schema identity]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="450" y="470" width="350" height="780" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b style='font-size:13px'&gt;AuthController&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ASP.NET Core Controller]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Login, renovación y revocación&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="500" width="300" height="105" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;TokenService&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;JWT y refresh tokens rotativos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="635" width="300" height="105" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;Gestión de usuarios y roles&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ASP.NET Core Identity]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Usuarios, roles y permisos&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="770" width="300" height="105" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b style='font-size:13px'&gt;Gestión de dispositivos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Registro y validación de equipos autorizados&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="475" y="905" width="300" height="105" as="geometry" /></mxCell><mxCell id="c21" value="&lt;b style='font-size:13px'&gt;Business Service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor · schemas sales, inventory, cash, audit]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="840" y="470" width="350" height="780" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b style='font-size:13px'&gt;Controllers de negocio&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ASP.NET Core Controllers]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Ventas, inventario, caja, compras, proveedores, clientes, recetas, reportes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="500" width="300" height="105" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;Servicios de dominio&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Pharmacy.Domain / Application]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Casos de uso para ventas, inventario, compras, caja, arqueos, cierres y reportes.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="635" width="300" height="105" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b style='font-size:13px'&gt;Repositorios EF Core&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[EF Core / Npgsql]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Persistencia por schema&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="770" width="300" height="105" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b style='font-size:13px'&gt;AuditWriter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Bitácora de operaciones críticas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="905" width="300" height="105" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b style='font-size:13px'&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor · lectura por vistas]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="1990" y="470" width="350" height="780" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b style='font-size:13px'&gt;NotificationsController&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[ASP.NET Core Controller (interno)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Recibe avisos internos, p. ej. discrepancias de conciliación&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2015" y="500" width="300" height="105" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b style='font-size:13px'&gt;AlertScheduler&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[BackgroundService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Vencimientos y stock mínimo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2015" y="635" width="300" height="105" as="geometry" /></mxCell><mxCell id="c29" value="&lt;b style='font-size:13px'&gt;ScheduledReportsGenerator&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Reportes programados&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2015" y="770" width="300" height="105" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b style='font-size:13px'&gt;SmtpAdapter&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Envío de correo SMTP/TLS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2015" y="905" width="300" height="105" as="geometry" /></mxCell><mxCell id="c40" value="&lt;b style='font-size:13px'&gt;PostgreSQL central&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Contenedor: PostgreSQL administrado]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Una instancia · schemas: sales · inventory · cash · identity · audit · sync. Un usuario por servicio con escritura solo en su schema.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="1300" width="600" height="160" as="geometry" /></mxCell><mxCell id="c41" value="&lt;b style='font-size:13px'&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;SMTP con TLS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2030" y="1510" width="260" height="100" as="geometry" /></mxCell><mxCell id="c42" value="Solicitudes (sync, login, consultas y reportes)&lt;br&gt;&lt;span style='font-size:9px'&gt;[HTTPS/REST + JWT]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exi