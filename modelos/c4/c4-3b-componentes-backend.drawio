as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Servicios de dominio&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Pharmacy.Domain / Application]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Casos de uso de ventas, inventario, compras, caja, arqueos, cierres y reportes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="635" width="300" height="105" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Repositorios EF Core&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[EF Core / Npgsql]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Persistencia por schema&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="770" width="300" height="105" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;AuditWriter&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Bitácora de operaciones críticas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="865" y="905" width="300" height="105" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor · lectura por vistas]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#438DD5;strokeWidth=2;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" vertex="1" parent="1"><mxGeometry x="1230" y="470" width="350" height="780" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;NotificationsController&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[ASP.NET Core Controller (interno)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Recibe solicitudes internas de envío de reportes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1255" y="500" width="300" height="105" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;AlertScheduler&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[BackgroundService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Vencimientos (60 días) y stock mínimo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1255" y="635" width="300" height="105" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;ScheduledReportsGenerator&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Reportes programados&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1255" y="770" width="300" height="105" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;SmtpAdapter&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Envío de correo SMTP/TLS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1255" y="905" width="300" height="105" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;PostgreSQL central&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Contenedor: PostgreSQL administrado]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Una instancia · schemas: sales · inventory · cash · identity · audit · sync. Un usuario por servicio con escritura solo en su schema.&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="1300" width="600" height="160" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;SMTP con TLS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=center;verticalAlign=middle;spacing=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1275" y="1520" width="260" height="100" as="geometry"/></mxCell><mxCell id="c31" value="Solicitudes (sync, login, consultas y reportes)&lt;br&gt;&lt;span style=&#x27;font-size:9px&#x27;&gt;[HTTPS/REST + JWT]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=8;strokeColor=#707070;strokeWidth=1.5;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=1;exitY=0.5;exitDx=0