{
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "identity", "RateLimiterPolicy": "por-puesto", "Match": { "Path": "/auth/{**rest}" } },
      "users": { "ClusterId": "identity", "RateLimiterPolicy": "por-puesto", "Match": { "Path": "/api/users/{**rest}" } },
      "users-root": { "ClusterId": "identity", "RateLimiterPolicy": "por-puesto", "Match": { "Path": "/api/users" } },
      "devices": { "ClusterId": "identity", "RateLimiterPolicy": "por-puesto", "Match": { "Path": "/api/devices" } },
      "attendance": { "ClusterId": "identity", "RateLimiterPolicy": "por-puesto", "Match": { "Path": "/api/attendance" } },
      "sync": { "ClusterId": "sync", "RateLimiterPolicy": "por-puesto", "Match": { "Path": "/sync/{**rest}" } },
      "business": { "ClusterId": "business", "RateLimiterPolicy": "por-puesto", "Order": 100, "Match": { "Path": "/api/{**rest}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "sync": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "business": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } }
    }
  },
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "Yarp": "Warning" } } },
  "AllowedHosts": "*"
}
