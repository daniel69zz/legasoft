<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta de la farmacia: verde farmacéutico + azul Legasoft -->
  <Styles.Resources>
    <SolidColorBrush x:Key="Brand" Color="#0F8B6E" />
    <SolidColorBrush x:Key="BrandDark" Color="#0B5E4B" />
    <SolidColorBrush x:Key="BrandSoft" Color="#E3F4EF" />
    <SolidColorBrush x:Key="Navy" Color="#123A5F" />
    <SolidColorBrush x:Key="Canvas" Color="#F3F7F6" />
    <SolidColorBrush x:Key="Muted" Color="#5B6B73" />
    <SolidColorBrush x:Key="Line" Color="#DCE6E3" />
    <SolidColorBrush x:Key="Danger" Color="#B83A3A" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FBEAEA" />
    <SolidColorBrush x:Key="Warn" Color="#B7791F" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FDF3E1" />
    <StreamGeometry x:Key="CrossIcon">M9,2 H15 V9 H22 V15 H15 V22 H9 V15 H2 V9 H9 Z</StreamGeometry>
    <FontFamily x:Key="Mono">Menlo, Consolas, monospace</FontFamily>
  </Styles.Resources>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="White" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{StaticResource BrandSoft}" />
  </Style>
  <Style Selector="Border.badge.warn">
    <Setter Property="Background" Value="{StaticResource WarnSoft}" />
  </Style>
  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{StaticResource DangerSoft}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Navy}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Navy}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.kpi">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Brand}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{StaticResource BrandDark}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Brand}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrandDark}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="#D6E4F0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1C4B75" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Brand}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Ellipse.status">
    <Setter Property="Fill" Value="{StaticResource Warn}" />
  </Style>
  <Style Selector="Ellipse.status.online">
    <Setter Property="Fill" Value="{StaticResource Brand}" />
  </Style>
</Styles>
