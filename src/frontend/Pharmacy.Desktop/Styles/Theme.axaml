<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Tema «cruz verde»: el letrero iluminado de las farmacias de barrio es el único elemento llamativo
    (menú lateral y login); el área de trabajo queda sobria y plana para jornadas largas en el mostrador.
    Contraste AA comprobado: texto principal y secundario ≥ 4.5:1 sobre blanco y sobre el lienzo.
  -->
  <Styles.Resources>
    <!-- Colores de marca (se conservan las claves que ya usan las vistas) -->
    <SolidColorBrush x:Key="Brand" Color="#0E7A5E" />
    <SolidColorBrush x:Key="BrandDark" Color="#095C47" />
    <SolidColorBrush x:Key="BrandSoft" Color="#E4F1EC" />
    <SolidColorBrush x:Key="BrandBright" Color="#3FD49A" />
    <SolidColorBrush x:Key="Navy" Color="#17302B" />
    <SolidColorBrush x:Key="Ink" Color="#17302B" />
    <SolidColorBrush x:Key="Canvas" Color="#F3F5F4" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Hover" Color="#EEF3F1" />
    <SolidColorBrush x:Key="Muted" Color="#56645F" />
    <SolidColorBrush x:Key="Line" Color="#DCE3E0" />
    <SolidColorBrush x:Key="LineStrong" Color="#C3CEC9" />
    <SolidColorBrush x:Key="Danger" Color="#B42318" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA" />
    <SolidColorBrush x:Key="Warn" Color="#8F5300" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FCF0DC" />

    <!-- Menú lateral -->
    <SolidColorBrush x:Key="Pine" Color="#12332D" />
    <SolidColorBrush x:Key="PineRaised" Color="#1B463E" />
    <SolidColorBrush x:Key="PineHover" Color="#173D36" />
    <SolidColorBrush x:Key="PineText" Color="#C5D6D1" />
    <SolidColorBrush x:Key="PineMuted" Color="#93ADA6" />

    <StreamGeometry x:Key="CrossIcon">M9,2 H15 V9 H22 V15 H15 V22 H9 V15 H2 V9 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="LogoutIcon">M14,4 H19 V20 H14 M10,8 L6,12 L10,16 M6,12 H16</StreamGeometry>
    <FontFamily x:Key="Mono">Menlo, Consolas, monospace</FontFamily>
  </Styles.Resources>

  <!-- Superficies -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{StaticResource BrandSoft}" />
  </Style>
  <Style Selector="Border.badge.warn">
    <Setter Property="Background" Value="{StaticResource WarnSoft}" />
  </Style>
  <Style Selector="Border.badge.danger">
    <Setter Property="Background" Value="{StaticResource DangerSoft}" />
  </Style>

  <!-- Tipografía: 12 · 13 · 15 · 24 · 28 -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.kpi">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
    <Setter Property="Foreground" Value="{StaticResource Brand}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{StaticResource BrandDark}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Margin" Value="0,0,0,-6" />
  </Style>

  <!-- Botones: secundario por defecto (borde), principal relleno, peligro en rojo -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Hover}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrandSoft}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Canvas}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Brand}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrandDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandDark}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#074A39" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
    <Setter Property="BorderBrush" Value="#F1C7C2" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerSoft}" />
    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Campos: mismo alto y radio; el foco usa el verde de la marca (acento de la paleta Fluent) -->
  <Style Selector="TextBox, ComboBox, NumericUpDown, CalendarDatePicker">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="TextBox, ComboBox, CalendarDatePicker, NumericUpDown">
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner">
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
  </Style>

  <!-- Listas del área de trabajo: fila resaltada al pasar y selección suave -->
  <Style Selector="ListBox:not(.nav) ListBoxItem">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox:not(.nav) ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Hover}" />
  </Style>
  <Style Selector="ListBox:not(.nav) ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrandSoft}" />
  </Style>
  <Style Selector="ListBox:not(.nav) ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#D5EAE2" />
  </Style>
  <Style Selector="ListBox:not(.nav) ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <!-- Menú lateral: el elemento activo se marca con la franja verde y el fondo elevado -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="10,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource PineText}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- El color del texto se fija en el ContentPresenter: Fluent lo cambia ahí según el estado (foco, selección) -->
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource PineText}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PineHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PineRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBright}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PineRaised}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PineRaised}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Páginas con desplazamiento: espacio para la barra, que Fluent dibuja encima del contenido -->
  <Style Selector="ScrollViewer.page">
    <Setter Property="Padding" Value="0,0,14,0" />
  </Style>

  <!-- Pestañas: tamaño acorde a los títulos de tarjeta -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="4,0,16,0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem Path.navicon">
    <Setter Property="Stroke" Value="{StaticResource PineMuted}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Path.navicon">
    <Setter Property="Stroke" Value="{StaticResource BrandBright}" />
  </Style>

  <!-- Íconos de línea (24 × 24, trazo redondeado) -->
  <Style Selector="Path.icon, Path.navicon">
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!-- El letrero: la cruz verde iluminada -->
  <Style Selector="Border.sign">
    <Setter Property="Background" Value="{StaticResource Brand}" />
    <Setter Property="BoxShadow" Value="0 0 22 2 #663FD49A" />
  </Style>

  <Style Selector="Ellipse.status">
    <Setter Property="Fill" Value="{StaticResource Warn}" />
  </Style>
  <Style Selector="Ellipse.status.online">
    <Setter Property="Fill" Value="{StaticResource Brand}" />
  </Style>
</Styles>
