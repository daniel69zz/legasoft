<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             xmlns:c="using:Pharmacy.Application.Contracts"
             x:Class="Pharmacy.Desktop.Views.CatalogView"
             x:DataType="vm:CatalogViewModel">
  <Grid ColumnDefinitions="*,380" ColumnSpacing="20">
    <!-- Búsqueda y listado (RF-011, RF-012) -->
    <Border Classes="card">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Watermark="Buscar por nombre, código, principio activo o categoría"
                 Text="{Binding Search}" Margin="0,0,0,12" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,120,90,90,Auto" Margin="10,0,10,6">
          <TextBlock Classes="muted" Text="Medicamento" />
          <TextBlock Grid.Column="1" Classes="muted" Text="Categoría" />
          <TextBlock Grid.Column="2" Classes="muted" Text="Precio" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Classes="muted" Text="Estado" Margin="12,0,0,0" />
        </Grid>
        <ListBox ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:ProductDto">
              <Grid ColumnDefinitions="*,120,90,90,Auto">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Concentration, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Classes="muted">
                    <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ActiveIngredient, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Laboratory, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Category}" />
                  <TextBlock Classes="muted" Text="Con receta" IsVisible="{Binding RequiresPrescription}" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding SalePrice, StringFormat='Bs {0:0.00}'}" />
                <Border Grid.Column="3" Classes="badge" Margin="12,0,0,0" VerticalAlignment="Center"
                        HorizontalAlignment="Left" IsVisible="{Binding IsActive}">
                  <TextBlock Text="Activo" FontSize="11" Foreground="{StaticResource BrandDark}" />
                </Border>
                <Border Grid.Column="3" Classes="badge danger" Margin="12,0,0,0" VerticalAlignment="Center"
                        HorizontalAlignment="Left" IsVisible="{Binding !IsActive}">
                  <TextBlock Text="Inactivo" FontSize="11" Foreground="{StaticResource Danger}" />
                </Border>
                <Button Grid.Column="4" Classes="small" Content="Activar / desactivar"
                        Command="{Binding $parent[UserControl].((vm:CatalogViewModel)DataContext).ToggleCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Formulario de registro y modificación (RF-009, RF-010) -->
    <ScrollViewer Grid.Column="1">
      <Border Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding FormTitle}" />
          <TextBox Watermark="Código de producto" Text="{Binding Code}" IsEnabled="{Binding !IsEditing}" />
          <TextBox Watermark="Nombre comercial" Text="{Binding Name}" />
          <TextBox Watermark="Principio activo" Text="{Binding ActiveIngredient}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox Watermark="Concentración" Text="{Binding Concentration}" />
            <TextBox Grid.Column="1" Watermark="Presentación" Text="{Binding Presentation}" />
          </Grid>
          <TextBox Watermark="Laboratorio" Text="{Binding Laboratory}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox Watermark="Categoría" Text="{Binding Category}" />
            <TextBox Grid.Column="1" Watermark="Ubicación" Text="{Binding Location}" />
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="Precio de venta (Bs)" />
              <NumericUpDown Value="{Binding SalePrice}" Minimum="0" Increment="0.5" FormatString="0.00" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="muted" Text="Stock mínimo" />
              <NumericUpDown Value="{Binding MinimumStock}" Minimum="0" Increment="1" FormatString="0" />
            </StackPanel>
          </Grid>
          <CheckBox Content="Requiere receta médica" IsChecked="{Binding RequiresPrescription}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" />
            <Button Content="Nuevo" Command="{Binding NewCommand}" />
          </StackPanel>
          <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="ok" Text="{Binding Info}" TextWrapping="Wrap"
                     IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
