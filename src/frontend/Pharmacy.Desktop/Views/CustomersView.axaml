<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             xmlns:conv="using:Pharmacy.Desktop.Converters"
             xmlns:c="using:Pharmacy.Application.Contracts"
             x:Class="Pharmacy.Desktop.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">
  <Grid ColumnDefinitions="*,340" ColumnSpacing="20">
    <!-- SCRUM-28 · HU-24: búsqueda (RF-086) e historial de compras (RF-087) -->
    <Grid RowDefinitions="*,Auto" RowSpacing="16">
      <Border Classes="card">
        <DockPanel>
          <TextBox DockPanel.Dock="Top" Watermark="Buscar por nombre o NIT/CI" Text="{Binding Search}" Margin="0,0,0,12" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,100,100" Margin="10,0,10,6">
            <TextBlock Classes="muted" Text="Cliente" />
            <TextBlock Grid.Column="1" Classes="muted" Text="NIT / CI" />
            <TextBlock Grid.Column="2" Classes="muted" Text="Teléfono" />
          </Grid>
          <ListBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="c:CustomerDto">
                <Grid ColumnDefinitions="*,100,100">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Email}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding TaxId}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Phone}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsEditing}">
        <StackPanel>
          <TextBlock Classes="h2" Text="Historial de compras (RF-087)" />
          <ItemsControl ItemsSource="{Binding Purchases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:CustomerPurchaseDto">
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding ReceiptNumber, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CreatedAt, Mode=OneWay, Converter={x:Static conv:LocalTime.Instance}, ConverterParameter='dd/MM/yyyy HH:mm'}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="muted" Text="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding Total, StringFormat='Bs {0:N2}'}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Registro y modificación (RF-084, RF-085) -->
    <ScrollViewer Grid.Column="1" Classes="page">
      <Border Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding FormTitle}" />
          <TextBlock Classes="label" Text="Nombre *" />
          <TextBox Watermark="Ej. María Quispe" Text="{Binding Name}" />
          <TextBlock Classes="label" Text="NIT / CI *" />
          <TextBox Watermark="Solo números, 5 a 15 dígitos" Text="{Binding TaxId}" />
          <TextBlock Classes="label" Text="Teléfono" />
          <TextBox Text="{Binding Phone}" />
          <TextBlock Classes="label" Text="Correo electrónico" />
          <TextBox Text="{Binding Email}" />
          <TextBlock Classes="muted" Text="* Obligatorio" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" />
            <Button Content="Nuevo" Command="{Binding NewCommand}" />
          </StackPanel>
          <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="ok" Text="{Binding Info}" TextWrapping="Wrap"
                     IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
