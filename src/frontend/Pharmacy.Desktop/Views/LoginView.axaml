<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             x:Class="Pharmacy.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid ColumnDefinitions="5*,4*">
    <!-- Panel de marca: el letrero de la cruz verde -->
    <Border Background="{StaticResource Pine}">
      <Grid RowDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Margin="72,48" Spacing="22" MaxWidth="560" HorizontalAlignment="Left">
          <Border Classes="sign" Width="84" Height="84" CornerRadius="20" HorizontalAlignment="Left">
            <PathIcon Data="{StaticResource CrossIcon}" Width="42" Height="42" Foreground="White" />
          </Border>
          <TextBlock Text="Sistema de Gestión para Farmacéutica" FontSize="34" FontWeight="Bold" LetterSpacing="-0.6"
                     LineHeight="40" Foreground="White" TextWrapping="Wrap" />
          <TextBlock Text="Ventas, caja e inventario que siguen funcionando sin Internet. Cada operación se guarda en el puesto y se sincroniza sola cuando vuelve la conexión."
                     FontSize="15" LineHeight="23" Foreground="{StaticResource PineText}" TextWrapping="Wrap" MaxWidth="460"
                     HorizontalAlignment="Left" />
          <WrapPanel>
            <Border Classes="badge" Background="Transparent" BorderBrush="#3A5E56" BorderThickness="1" Margin="0,0,8,8" Padding="10,4">
              <TextBlock Text="FEFO y lotes vencidos" Foreground="{StaticResource PineText}" FontSize="12" />
            </Border>
            <Border Classes="badge" Background="Transparent" BorderBrush="#3A5E56" BorderThickness="1" Margin="0,0,8,8" Padding="10,4">
              <TextBlock Text="Outbox + sincronización" Foreground="{StaticResource PineText}" FontSize="12" />
            </Border>
            <Border Classes="badge" Background="Transparent" BorderBrush="#3A5E56" BorderThickness="1" Margin="0,0,8,8" Padding="10,4">
              <TextBlock Text="Roles y auditoría" Foreground="{StaticResource PineText}" FontSize="12" />
            </Border>
          </WrapPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Prototipo inicial · Legasoft · UCB 2026" Foreground="{StaticResource PineMuted}"
                   FontSize="12" Margin="72,0,72,32" />
      </Grid>
    </Border>

    <!-- Formulario -->
    <Border Grid.Column="1" Classes="card" Margin="56" VerticalAlignment="Center" Padding="36" MaxWidth="460">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4" Margin="0,0,0,6">
          <TextBlock Classes="h1" Text="Iniciar sesión" />
          <TextBlock Classes="muted" TextWrapping="Wrap">
            <Run Text="Puesto" />
            <Run Text="{Binding DeviceId, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="· servidor" />
            <Run Text="{Binding Server, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <TextBlock Classes="label" Text="Usuario" />
        <TextBox Watermark="Ej. cajero1" Text="{Binding UserName}" />
        <TextBlock Classes="label" Text="Contraseña" />
        <TextBox Watermark="Su contraseña" PasswordChar="●" Text="{Binding Password}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="primary" Content="Ingresar" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                HorizontalContentAlignment="Center" Command="{Binding LoginCommand}" IsDefault="True" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Background="{StaticResource Canvas}" CornerRadius="8" Padding="12" Margin="0,6,0,0">
          <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="18"
                     Text="Usuarios de demostración: admin, cajero1, cajero2, farmaceutico, gerente, contadora, operaciones, almacen. Contraseña de demo en appsettings.json (Seed:DemoPassword)." />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
