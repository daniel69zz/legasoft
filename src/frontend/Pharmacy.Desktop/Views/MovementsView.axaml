<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             xmlns:conv="using:Pharmacy.Desktop.Converters"
             xmlns:c="using:Pharmacy.Application.Contracts"
             x:Class="Pharmacy.Desktop.Views.MovementsView"
             x:DataType="vm:MovementsViewModel">
  <Border Classes="card">
    <DockPanel>
      <!-- Filtros (HU-06.4, RF-019) -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="160,160,170,*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
        <CalendarDatePicker SelectedDate="{Binding From}" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                            Watermark="Desde" HorizontalAlignment="Stretch" />
        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding To}" SelectedDateFormat="Custom"
                            CustomDateFormatString="dd/MM/yyyy" Watermark="Hasta" HorizontalAlignment="Stretch" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" />
        <TextBox Grid.Column="3" Watermark="Filtrar por producto o código" Text="{Binding Search}" />
        <Button Grid.Column="4" Classes="primary" Content="Consultar" Command="{Binding FilterCommand}" />
      </Grid>
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="muted" Text="{Binding Info}" IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="muted">
          <Run Text="{Binding Movements.Count, Mode=OneWay}" /><Run Text=" movimientos · saldo neto " /><Run Text="{Binding TotalUnits, Mode=OneWay, StringFormat='{}{0:+0;-0;0}'}" FontWeight="SemiBold" /><Run Text=" u." />
        </TextBlock>
      </StackPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="130,*,110,90,80,*,110" ColumnSpacing="8" Margin="10,0,10,6">
        <TextBlock Classes="muted" Text="Fecha" />
        <TextBlock Grid.Column="1" Classes="muted" Text="Producto" />
        <TextBlock Grid.Column="2" Classes="muted" Text="Lote" />
        <TextBlock Grid.Column="3" Classes="muted" Text="Tipo" />
        <TextBlock Grid.Column="4" Classes="muted" Text="Cantidad" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="5" Classes="muted" Text="Motivo" />
        <TextBlock Grid.Column="6" Classes="muted" Text="Usuario" />
      </Grid>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Movements}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="c:InventoryMovementDto">
              <Border Classes="row">
                <Grid ColumnDefinitions="130,*,110,90,80,*,110" ColumnSpacing="8">
                  <TextBlock Text="{Binding OccurredAt, Converter={x:Static conv:LocalTime.Instance}, ConverterParameter='dd/MM/yyyy HH:mm'}" />
                  <TextBlock Grid.Column="1" Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding LotNumber}" />
                  <TextBlock Grid.Column="3" Text="{Binding Type}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontWeight="SemiBold"
                             Text="{Binding Quantity, StringFormat='{}{0:+0;-0}'}" />
                  <TextBlock Grid.Column="5" Classes="muted" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="6" Text="{Binding UserName}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
