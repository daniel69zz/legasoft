<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             xmlns:conv="using:Pharmacy.Desktop.Converters"
             xmlns:c="using:Pharmacy.Application.Contracts"
             x:Class="Pharmacy.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Spacing="16">
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="ok" Text="{Binding Info}" IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="muted" Text="Datos consolidados en el servidor (PostgreSQL) a partir de lo sincronizado por todos los puestos." />

      <!-- SCRUM-129 · HU-18.1 (RF-105): exportación a Excel -->
      <Border Classes="card">
        <Grid ColumnDefinitions="*,140,140,Auto" ColumnSpacing="10">
          <TextBlock Classes="h2" Text="Exportar a Excel (RF-105)" VerticalAlignment="Center" Margin="0" />
          <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding ExportFrom}" SelectedDateFormat="Custom"
                              CustomDateFormatString="dd/MM/yyyy" Watermark="Desde" HorizontalAlignment="Stretch" />
          <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding ExportTo}" SelectedDateFormat="Custom"
                              CustomDateFormatString="dd/MM/yyyy" Watermark="Hasta" HorizontalAlignment="Stretch" />
          <Button Grid.Column="3" Classes="primary" Content="Exportar (.xlsx)" ToolTip.Tip="Ventas, egresos y cierres del período"
                  Command="{Binding ExportCommand}" />
        </Grid>
      </Border>
      <!-- SCRUM-31 · HU-18: reportes del período y cierre diario, en pantalla, Excel o PDF -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Reportes operativos (RF-068 a RF-072, RF-103)" />
          <Grid ColumnDefinitions="2*,140,140,*" ColumnSpacing="10">
            <ComboBox ItemsSource="{Binding ReportChoices}" SelectedItem="{Binding ReportKind}" HorizontalAlignment="Stretch" />
            <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding ReportFrom}" SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy" Watermark="Desde" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsRange}" />
            <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding ReportTo}" SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy" Watermark="Hasta" HorizontalAlignment="Stretch" />
            <TextBox Grid.Column="3" Watermark="Sucursal (opcional, RF-100)" Text="{Binding Branch}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Ver reporte" Command="{Binding ViewReportCommand}" />
            <Button Content="Excel" Command="{Binding ExportReportCommand}" CommandParameter="xlsx" />
            <Button Content="PDF" Command="{Binding ExportReportCommand}" CommandParameter="pdf" />
            <Button Content="Resumen de la sucursal" Command="{Binding BranchSummaryCommand}" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding Report, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock FontWeight="SemiBold">
              <Run Text="{Binding Report.Title, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Report.Subtitle, Mode=OneWay}" />
            </TextBlock>
            <ScrollViewer Classes="page" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="320">
              <SelectableTextBlock FontFamily="{StaticResource Mono}" FontSize="11" Text="{Binding ReportPreview}" />
            </ScrollViewer>
          </StackPanel>
          <SelectableTextBlock FontFamily="{StaticResource Mono}" FontSize="11" Text="{Binding BranchSummary}"
                               IsVisible="{Binding BranchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="16" IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="Ventas de hoy" TextWrapping="Wrap" /><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Classes="kpi" Text="{Binding Summary.SalesToday, StringFormat='Bs {0:N2}'}" /></Viewbox><TextBlock Classes="muted" Text="{Binding Summary.SalesCountToday, StringFormat='{}{0} ventas'}" /></StackPanel></Border>
        <Border Grid.Column="1" Classes="card"><StackPanel><TextBlock Classes="muted" Text="Últimos 7 días" TextWrapping="Wrap" /><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Classes="kpi" Text="{Binding Summary.SalesLast7Days, StringFormat='Bs {0:N2}'}" /></Viewbox></StackPanel></Border>
        <Border Grid.Column="2" Classes="card"><StackPanel><TextBlock Classes="muted" Text="Productos en stock mínimo" TextWrapping="Wrap" /><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Classes="kpi" Foreground="{StaticResource Danger}" Text="{Binding Summary.LowStockProducts}" /></Viewbox></StackPanel></Border>
        <Border Grid.Column="3" Classes="card"><StackPanel><TextBlock Classes="muted" Text="Lotes por vencer / vencidos" TextWrapping="Wrap" /><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Classes="kpi" Foreground="{StaticResource Warn}"><Run Text="{Binding Summary.ExpiringLots, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Summary.ExpiredLots, Mode=OneWay}" /></TextBlock></Viewbox></StackPanel></Border>
        <Border Grid.Column="4" Classes="card"><StackPanel><TextBlock Classes="muted" Text="Cierres con diferencia" TextWrapping="Wrap" /><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Classes="kpi" Foreground="{StaticResource Navy}" Text="{Binding Summary.ClosuresWithDifference}" /></Viewbox></StackPanel></Border>
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,180" ColumnSpacing="8" Margin="0,0,0,8">
              <TextBlock Classes="h2" Text="Ventas por cajero (RF-074)" VerticalAlignment="Center" Margin="0" />
              <!-- SCRUM-32 · HU-19: agrupación por día, semana o mes -->
              <ComboBox Grid.Column="1" ItemsSource="{Binding GroupingChoices}" SelectedItem="{Binding Grouping}"
                        HorizontalAlignment="Stretch" />
            </Grid>
            <ItemsControl ItemsSource="{Binding SalesByCashier}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:SalesByCashierRow">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="90,*,Auto,96" ColumnSpacing="8">
                      <TextBlock Text="{Binding Day, StringFormat='{}{0:dd/MM/yyyy}'}" />
                      <TextBlock Grid.Column="1" Text="{Binding CashierName}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Sales, StringFormat='{}{0} ventas'}" />
                      <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding Total, StringFormat='Bs {0:N2}'}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel>
            <TextBlock Classes="h2" Text="Auditoría de operaciones críticas (RF-075)" />
            <StackPanel Spacing="6" Margin="0,0,0,8" IsVisible="{Binding CanAudit}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <CalendarDatePicker SelectedDate="{Binding AuditFrom}" SelectedDateFormat="Custom"
                                    CustomDateFormatString="dd/MM/yyyy" Watermark="Desde" HorizontalAlignment="Stretch" />
                <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding AuditTo}" SelectedDateFormat="Custom"
                                    CustomDateFormatString="dd/MM/yyyy" Watermark="Hasta" HorizontalAlignment="Stretch" />
              </Grid>
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <TextBox Watermark="Usuario" Text="{Binding AuditUser}" />
                <TextBox Grid.Column="1" Watermark="Operación (p. ej. Movimiento de inventario)" Text="{Binding AuditAction}" />
                <Button Grid.Column="2" Content="Filtrar" Command="{Binding FilterAuditCommand}" />
              </Grid>
            </StackPanel>
            <TextBlock Classes="muted" Text="Su rol no consulta la auditoría." IsVisible="{Binding !CanAudit}" />
            <ItemsControl ItemsSource="{Binding Audit}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:AuditEntryDto">
                  <Border Classes="row">
                    <StackPanel>
                      <TextBlock>
                        <Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding UserName, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Classes="muted" TextWrapping="Wrap">
                        <Run Text="{Binding OccurredAt, Mode=OneWay, Converter={x:Static conv:LocalTime.Instance}, ConverterParameter='dd/MM HH:mm'}" /><Run Text=" · " /><Run Text="{Binding DeviceId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
