<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             xmlns:c="using:Pharmacy.Application.Contracts"
             xmlns:conv="using:Pharmacy.Desktop.Converters"
             x:Class="Pharmacy.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer Classes="page">
    <StackPanel Spacing="16">
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="ok" Text="{Binding Info}" IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <StackPanel Spacing="16">
          <!-- SCRUM-130 · HU-28.1: parámetros operativos (RF-099) -->
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="Parámetros operativos de inventario (RF-099)" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Se guardan en el servidor. Los puestos aplican el umbral de vencimiento y el descuento máximo en la siguiente sincronización y el Notification Worker usa la nueva frecuencia en su próximo ciclo." />
              <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Umbral de alerta de vencimiento" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="Días antes del vencimiento en que un lote pasa a «Por vencer» (1 a 365)." TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown Grid.Column="1" Value="{Binding ExpiryThresholdDays}" Minimum="1" Maximum="365" Increment="5"
                               FormatString="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                  <TextBlock Text="Frecuencia de las alertas por correo" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="Minutos entre envíos del Notification Worker (5 a 1440)." TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding AlertIntervalMinutes}" Minimum="5" Maximum="1440"
                               Increment="5" FormatString="0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                  <TextBlock Text="Descuento máximo autorizado" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="Porcentaje del subtotal que se puede descontar en una venta (0 a 100, RF-096)." TextWrapping="Wrap" />
                </StackPanel>
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxDiscountPercent}" Minimum="0" Maximum="100"
                               Increment="5" FormatString="0" VerticalAlignment="Center" />
              </Grid>
              <Button Classes="primary" Content="Guardar parámetros" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <!-- SCRUM-34 · HU-29: sucursal de cada puesto (RF-100) -->
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Sucursal de cada puesto (RF-100)" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Las ventas, la caja y los movimientos de stock de un puesto quedan marcados con su sucursal. Un puesto sin asignar pertenece a la sucursal de los datos de la empresa." />
              <ItemsControl ItemsSource="{Binding BranchDevices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="c:BranchDeviceDto">
                    <Border Classes="row">
                      <Grid ColumnDefinitions="*,*">
                        <TextBlock Text="{Binding DeviceId}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Branch}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <TextBox Watermark="Puesto (p. ej. PUESTO-02)" Text="{Binding DeviceToAssign}" />
                <TextBox Grid.Column="1" Watermark="Sucursal" Text="{Binding DeviceBranch}" />
                <Button Grid.Column="2" Content="Asignar" Command="{Binding AssignBranchCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="16">
          <!-- SCRUM-33 · HU-28: datos de la empresa y de la sucursal (RF-097, RF-098) -->
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Empresa y sucursal (RF-097, RF-098)" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Aparecen en los recibos, los reportes y las facturas simuladas." />
              <TextBlock Classes="label" Text="Nombre de la empresa *" />
              <TextBox Text="{Binding CompanyName}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="NIT" Margin="0" />
                  <TextBox Text="{Binding CompanyTaxId}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="label" Text="Teléfono" Margin="0" />
                  <TextBox Text="{Binding CompanyPhone}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="label" Text="Dirección de la empresa" />
              <TextBox Text="{Binding CompanyAddress}" />
              <TextBlock Classes="label" Text="Sucursal *" />
              <TextBox Text="{Binding BranchName}" />
              <TextBlock Classes="label" Text="Dirección de la sucursal" />
              <TextBox Text="{Binding BranchAddress}" />
              <Button Classes="primary" Content="Guardar datos de la empresa" Command="{Binding SaveCompanyCommand}"
                      HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <!-- SCRUM-36 · HU-23: respaldo y recuperación (RF-082, RF-083) -->
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Respaldos (RF-082, RF-083)" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="El servidor genera un respaldo automático cada 24 horas y conserva 14 días. Recuperar reemplaza la información del servidor; antes se guarda un respaldo del estado actual." />
              <Button Content="Generar respaldo ahora" Command="{Binding CreateBackupCommand}" HorizontalAlignment="Left" />
              <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="220"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="c:BackupDto">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding CreatedAt, Mode=OneWay, Converter={x:Static conv:LocalTime.Instance}, ConverterParameter='dd/MM/yyyy HH:mm'}" /><Run Text=" · " /><Run Text="{Binding Kind, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Classes="muted">
                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Rows, Mode=OneWay}" /><Run Text=" filas · " /><Run Text="{Binding CreatedBy, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <CheckBox Content="Entiendo que la recuperación reemplaza la información actual" IsChecked="{Binding ConfirmRestore}" />
              <Button Classes="danger" Content="Recuperar el respaldo elegido" Command="{Binding RestoreBackupCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
