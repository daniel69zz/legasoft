<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             x:Class="Pharmacy.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="248,*">
    <!-- Menú lateral según rol -->
    <Border Background="{StaticResource Navy}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,26" Spacing="10">
          <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brand}">
            <PathIcon Data="{StaticResource CrossIcon}" Width="18" Height="18" Foreground="White" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Farmacia" Foreground="White" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="Sopocachi · La Paz" Foreground="#A9C7D8" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="20" Spacing="6">
          <TextBlock Text="{Binding Session.FullName}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Foreground="#A9C7D8" FontSize="12">
            <Run Text="{Binding RoleLabel, Mode=OneWay}" />
            <Run Text="·" />
            <Run Text="{Binding Session.DeviceId, Mode=OneWay}" />
          </TextBlock>
          <Button Content="Cerrar sesión" Command="{Binding LogoutCommand}" Foreground="White"
                  Background="#1C4B75" Margin="0,6,0,0" />
        </StackPanel>

        <ListBox Classes="nav" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.75" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Contenido -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
              Padding="24,14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="h1" Text="{Binding Selected.Title}" />
            <TextBlock Classes="muted" Text="{Binding Selected.Subtitle}" />
          </StackPanel>
          <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="status" Classes.online="{Binding Status.IsOnline}" Width="10" Height="10" />
              <TextBlock Text="{Binding Status.Summary}" FontSize="12" Foreground="{StaticResource Navy}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <ContentControl Content="{Binding Page}" Margin="24" />
    </DockPanel>
  </Grid>
</UserControl>
