<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             xmlns:conv="using:Pharmacy.Desktop.Converters"
             x:Class="Pharmacy.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <Grid ColumnDefinitions="252,*">
    <!-- Menú lateral según rol -->
    <Border Background="{StaticResource Pine}">
      <DockPanel>
        <!-- El letrero de la farmacia -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,20,28" Spacing="12">
          <Border Classes="sign" Width="40" Height="40" CornerRadius="10">
            <PathIcon Data="{StaticResource CrossIcon}" Width="20" Height="20" Foreground="White" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Farmacia" Foreground="White" FontWeight="Bold" FontSize="17" />
            <TextBlock Text="Sopocachi · La Paz" Foreground="{StaticResource PineMuted}" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <!-- Sesión -->
        <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="12" CornerRadius="10"
                Background="{StaticResource PineHover}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PineRaised}"
                      BorderBrush="{StaticResource Brand}" BorderThickness="1">
                <TextBlock Text="{Binding Session.FullName, Converter={x:Static conv:Initials.Instance}}"
                           Foreground="White" FontWeight="SemiBold" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Session.FullName}" Foreground="White" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.FullName}" />
                <TextBlock Foreground="{StaticResource PineMuted}" FontSize="12" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding RoleLabel, Mode=OneWay}" />
                  <Run Text="·" />
                  <Run Text="{Binding Session.DeviceId, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </Grid>
            <Button Command="{Binding LogoutCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="Transparent" BorderBrush="#3A5E56" Foreground="{StaticResource PineText}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Width="16" Height="16">
                  <Path Classes="icon" Data="{StaticResource LogoutIcon}" Stroke="{StaticResource PineText}" />
                </Viewbox>
                <TextBlock Text="Cerrar sesión" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <ListBox Classes="nav" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                  <Path Classes="navicon" Data="{Binding Title, Converter={x:Static conv:NavIcon.Instance}}" />
                </Viewbox>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Contenido -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
              BorderThickness="0,0,0,1" Padding="28,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="h1" Text="{Binding Selected.Title}" />
            <TextBlock Classes="muted" FontSize="13" Text="{Binding Selected.Subtitle}" />
          </StackPanel>
          <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,7" CornerRadius="18"
                  Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="status" Classes.online="{Binding Status.IsOnline}" Width="9" Height="9"
                       VerticalAlignment="Center" />
              <TextBlock Text="{Binding Status.Summary}" FontSize="12" Foreground="{StaticResource Ink}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <ContentControl Content="{Binding Page}" Margin="28,24" />
    </DockPanel>
  </Grid>
</UserControl>
