<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pharmacy.Desktop.ViewModels"
             xmlns:c="using:Pharmacy.Application.Contracts"
             x:Class="Pharmacy.Desktop.Views.SuppliersView"
             x:DataType="vm:SuppliersViewModel">
  <Grid ColumnDefinitions="*,380" ColumnSpacing="20">
    <!-- Listado de proveedores -->
    <Grid>
      <Border Classes="card">
        <DockPanel>
          <TextBox DockPanel.Dock="Top" Watermark="Buscar por razón social, NIT o contacto"
                   Text="{Binding Search}" Margin="0,0,0,12" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,140,90,Auto" Margin="10,0,10,6">
            <TextBlock Classes="muted" Text="Proveedor" />
            <TextBlock Grid.Column="1" Classes="muted" Text="Teléfono" />
            <TextBlock Grid.Column="2" Classes="muted" Text="Estado" />
          </Grid>
          <ListBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="c:SupplierDto">
                <Grid ColumnDefinitions="*,140,90,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted">
                      <Run Text="NIT " /><Run Text="{Binding TaxId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ContactName, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Phone}" />
                  <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center" HorizontalAlignment="Left"
                          IsVisible="{Binding IsActive}">
                    <TextBlock Text="Activo" FontSize="11" Foreground="{StaticResource BrandDark}" />
                  </Border>
                  <Border Grid.Column="2" Classes="badge danger" VerticalAlignment="Center" HorizontalAlignment="Left"
                          IsVisible="{Binding !IsActive}">
                    <TextBlock Text="Inactivo" FontSize="11" Foreground="{StaticResource Danger}" />
                  </Border>
                  <Button Grid.Column="3" Classes="small" Content="Activar / desactivar"
                          Command="{Binding $parent[UserControl].((vm:SuppliersViewModel)DataContext).ToggleCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Registro y modificación (RF-026, RF-027) -->
    <ScrollViewer Grid.Column="1">
      <Border Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="{Binding FormTitle}" />
          <TextBox Watermark="NIT (obligatorio)" Text="{Binding TaxId}" IsEnabled="{Binding !IsEditing}" />
          <TextBox Watermark="Razón social (obligatoria)" Text="{Binding Name}" />
          <TextBox Watermark="Teléfono (obligatorio)" Text="{Binding Phone}" />
          <TextBox Watermark="Persona de contacto" Text="{Binding ContactName}" />
          <TextBox Watermark="Correo electrónico" Text="{Binding Email}" />
          <TextBox Watermark="Dirección" Text="{Binding Address}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" />
            <Button Content="Nuevo" Command="{Binding NewCommand}" />
          </StackPanel>
          <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="ok" Text="{Binding Info}" TextWrapping="Wrap"
                     IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
